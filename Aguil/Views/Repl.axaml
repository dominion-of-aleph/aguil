<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ae="https://github.com/avaloniaui/avaloniaedit"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Aguil.Views.Repl"
        xmlns:vm="using:Aguil.ViewModels"
        xmlns:editor="using:Aguil.Editor"
        xmlns:alviews="using:Aguil.ALViews"
        x:DataType="vm:ReplViewModel"
        FontSize="16"
        Title="Repl">
    <Window.Styles>
        <Style Selector="ae|TextEditor">
            <Setter Property="FontFamily" Value="Fira Code,avares://Aguil/Assets/Fonts#Fira Code" />
            <Setter Property="ShowLineNumbers" Value="False" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="editor:Code.Grammar" Value="elixir" />
            <Setter Property="editor:Code.Keymap" Value="{x:Static editor:Keymaps.defaults}" />
        </Style>
        <Style Selector="Border.bar">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
        </Style>
        <Style Selector="Border.binding">
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.binding:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundAccentBrush}" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="17" />
        </Style>
        <Style Selector="Thumb.preview-resize">
            <Setter Property="Height" Value="6" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent">
                        <Border Height="2" Width="32" CornerRadius="1" VerticalAlignment="Center"
                                Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
    </Window.Styles>

    <Window.KeyBindings>
        <KeyBinding Gesture="Alt+OemSemicolon" Command="{Binding NextSolutionCommand}" />
        <KeyBinding Gesture="Alt+OemPeriod" Command="{Binding AllSolutionsCommand}" />
    </Window.KeyBindings>

    <ScrollViewer HorizontalScrollBarVisibility="Hidden">
        <StackPanel Orientation="Horizontal" Name="Flow">
            <!-- Change AL-USER to include the branch -->
            <ScrollViewer Name="Scroll">
                <StackPanel>
                    <ListBox Name="Entries" ItemsSource="{Binding History}" SelectedItem="{Binding Selected}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                            </Style>
                            <Style Selector="ListBoxItem /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="ListBoxItem:selected Border.entry">
                                <Setter Property="BorderBrush"
                                        Value="{DynamicResource SystemControlForegroundAccentBrush}" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReplEntry">
                                <Border Classes="entry"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                        BorderThickness="1" CornerRadius="4"
                                        Padding="8" Margin="0,0,0,6" Background="Transparent">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="AL-USER> "
                                                       Foreground="DarkSlateBlue" />
                                            <ae:TextEditor IsReadOnly="True" editor:Code.Text="{Binding Source}" />
                                        </DockPanel>

                                        <ContentControl Content="{Binding}">
                                            <!-- Include this in a tab view, failures of the protocol should be an object -->
                                            <ContentControl.DataTemplates>
                                                <!-- Change to a tab view -->
                                                <DataTemplate x:DataType="vm:ReplSuccess">
                                                    <StackPanel>
                                                        <TabControl Classes="result-tabs" Padding="0"
                                                                    alviews:SolutionView.Solution="{Binding Solution}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="4"
                                                                    Margin="0,4,0,0">
                                                            <Button Command="{Binding PrevCommand}"
                                                                    ToolTip.Tip="Previous solution">
                                                                <PathIcon Width="10" Height="10"
                                                                          Data="M 10,0 L 10,12 L 1,6 Z" />
                                                            </Button>
                                                            <Button Command="{Binding NextCommand}"
                                                                    ToolTip.Tip="Next solution">
                                                                <PathIcon Width="10" Height="10"
                                                                          Data="M 2,0 L 2,12 L 11,6 Z" />
                                                            </Button>
                                                            <TextBlock Text="{Binding Position}"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="DimGray" />
                                                            <Button Content="Copy all" Click="CopyResult"
                                                                    Focusable="False"
                                                                    Padding="8,2" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>

                                                <DataTemplate x:DataType="vm:ReplFailure">
                                                    <StackPanel>
                                                        <Border Classes="bar" Background="IndianRed" />
                                                        <ae:TextEditor IsReadOnly="True"
                                                                       editor:Code.Text="{Binding Error}"
                                                                       editor:Code.Grammar="{x:Null}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ContentControl.DataTemplates>
                                        </ContentControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="AL-USER> " Foreground="DarkSlateBlue" />
                        <ae:TextEditor Name="Input" />
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </ScrollViewer>
</Window>
