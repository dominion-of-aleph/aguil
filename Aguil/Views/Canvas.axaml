<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Aguil.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Aguil.Views.Canvas"
        Title="Canvas" Width="1100" Height="780"
        x:DataType="views:WindowManager">
    <ScrollViewer x:Name="Scroll" BringIntoViewOnFocusChange="False" HorizontalScrollBarVisibility="Hidden">

        <ContentControl Content="{Binding Content}" />
    </ScrollViewer>
</Window>