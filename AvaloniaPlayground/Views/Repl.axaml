<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ae="https://github.com/avaloniaui/avaloniaedit"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AvaloniaPlayground.Views.Repl"
        xmlns:vm="using:AvaloniaPlayground.ViewModels"
        xmlns:avaloniaPlayground="clr-namespace:AvaloniaPlayground"
        x:DataType="vm:ReplViewModel"
        FontSize="16"
        Title="Repl">
    <!-- Change AL-USER to include the branch -->
    <ScrollViewer Name="Scroll">
        <StackPanel>
            <ItemsControl ItemsSource="{Binding History}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReplEntry">
                        <StackPanel>
                            <SelectableTextBlock>
                                <Run Text="AL-USER> " Foreground="DarkSlateBlue" />
                                <Run Text="{Binding Source}" />
                            </SelectableTextBlock>
                            <!-- Change to a tab view -->
                            <ContentControl Content="{Binding}">
                                <ContentControl.DataTemplates>
                                    <DataTemplate x:DataType="vm:ReplSuccess">
                                        <SelectableTextBlock Foreground="LightSeaGreen" Text="{Binding Result}" />
                                    </DataTemplate>
                                    <DataTemplate x:DataType="vm:ReplFailure">
                                        <SelectableTextBlock Foreground="IndianRed" Text="{Binding Error}" />
                                    </DataTemplate>
                                </ContentControl.DataTemplates>
                            </ContentControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="AL-USER> " Foreground="DarkSlateBlue" />
                <ae:TextEditor Name="Input" ShowLineNumbers="False"
                               FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
                               VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Window>